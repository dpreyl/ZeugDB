# ZeugDB – Development Dockerfile
# Wird von docker-compose.yml für den Dev-Server genutzt.
# Mountet das Host-Verzeichnis für Hot-Reloading.

FROM node:22-alpine

WORKDIR /app

# Dependencies installieren (generiert package-lock.json bei Bedarf)
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Quelle wird als Volume gemountet – kein COPY nötig
EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "--port", "3000"]
