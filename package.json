{
  "name": "zeugdb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:pages": "vite build && node scripts/prepare-pages.js",
    "build:offline": "vite build && node scripts/inline.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^28.0.0",
    "msw": "^2.7.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.10.3",
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.25.0",
    "leaflet": "^1.9.4",
    "sql.js": "^1.12.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "msw@2.15.0": true
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    }
  }
}
